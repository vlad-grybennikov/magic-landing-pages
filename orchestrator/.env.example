# Images
# https://www.pexels.com/api/
PEXELS_API_KEY=
# clip | stub
MLP_IMAGES=

# Icons
# lucide | bundled
MLP_ICONS=

# LLM
# Default provider: ollama | openrouter | stub
MLP_LLM=ollama
# Default model, empty = provider default (qwen3.5:latest or qwen/qwen3.5-27b)
MLP_LLM_MODEL=
# Extra models offered in the chat, provider:model separated by commas
# e.g. openrouter:google/gemini-3.8-flash,openrouter:deepseek/deepseek-v4-flash-0731,openrouter:deepseek/deepseek-v4-flash-0731:free,openrouter:qwen/qwen3.5-27b
MLP_LLM_MODELS=
# OpenRouter models tried in order when the chosen one is rate-limited or down, separated by commas
# e.g. deepseek/deepseek-v4-flash-0731,qwen/qwen3.5-27b
MLP_LLM_FALLBACKS=
MLP_LLM_TIMEOUT=90
OLLAMA_URL=http://localhost:11434
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_URL=https://openrouter.ai/api/v1

# Speech
# local (faster-whisper on this machine) | openai | groq
MLP_STT=local
MLP_STT_LANG=en
# Empty = provider default (large-v3-turbo, whisper-1, whisper-large-v3-turbo)
MLP_STT_MODEL=
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# https://console.groq.com/keys
GROQ_API_KEY=

# Dialogue
MLP_SESSION_TTL=900
MLP_MAX_CLARIFICATIONS=2

# Storage
MONGO_URL=mongodb://localhost:27017
MONGO_DB=vlp-local

# Runtime
# development | production
MLP_ENV=development
MLP_CORS_ORIGINS=*
MLP_MAX_COMMANDS=2
MLP_COMMAND_TTL_DAYS=7

# Auth
# Empty = no sign-in
GOOGLE_CLIENT_ID=
MLP_JWT_SECRET=
MLP_ACCESS_TTL_MIN=15
MLP_REFRESH_TTL_DAYS=30

# Build identity, stamped into the image by scripts/ecr-build-push.sh and reported by /health
MLP_RELEASE=
MLP_COMMIT=
