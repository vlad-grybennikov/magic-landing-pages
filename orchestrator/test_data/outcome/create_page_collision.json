{
  "instruction": "Create a landing page for Maria's Bakery targeting young families to take online orders",
  "variants": [
    "I need another page for Maria's Bakery, still targeting young families for online orders",
    "Set up a second Maria's Bakery page aimed at young families to take online orders"
  ],
  "setup": [
    {
      "version": 1,
      "name": "Maria's Bakery",
      "url": "/maria-s-bakery",
      "sections": [
        {
          "type": "hero",
          "headline": "The original published page",
          "image": {
            "src": "/images/hero-section.jpg",
            "alt": ""
          },
          "button": {
            "label": "Order"
          }
        }
      ]
    }
  ],
  "expect": {
    "changed": {
      "pages": {
        "/maria-s-bakery": {
          "name": "Maria's Bakery",
          "publish": false,
          "section_types": "hero",
          "n_sections": 1
        }
      }
    },
    "created": {
      "pages": {
        "/maria-s-bakery-2": {
          "name": "Maria's Bakery",
          "publish": false,
          "section_types": {
            "$startswith": "header,hero",
            "$contains": [
              "benefits",
              "testimonials",
              "faq"
            ]
          },
          "n_sections": {
            "$between": [
              7,
              11
            ]
          }
        }
      }
    }
  }
}
